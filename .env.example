# ============================================
# Agenda Cartes FR — Environment Variables
# ============================================
# Copy this file to .env.local for local development
#
# SETUP GUIDE:
# 1. Create a free account on sanity.io
# 2. Run: cd apps/web && pnpm create sanity@latest
# 3. Create tokens in Dashboard → API → Tokens
# 4. Configure webhook in Dashboard → API → Webhooks

# --- Web App (Next.js) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id   # Found in sanity.io dashboard
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=                           # "Viewer" token from Dashboard → API → Tokens
SANITY_API_WRITE_TOKEN=                          # "Editor" token (used by submissions API route)
SANITY_WEBHOOK_SECRET=                           # Random secret — generate with: openssl rand -hex 32

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret between web and crawler for /api/admin/crawler/trigger
CRAWLER_SECRET=change-me-to-a-strong-random-secret

# --- Crawler (Node.js) ---
SANITY_PROJECT_ID=your-project-id               # Same as NEXT_PUBLIC_SANITY_PROJECT_ID
SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=                          # "Editor" token — can write events & crawlRuns
CRAWLER_PORT=3001

# URL of the Next.js app (for ISR webhook trigger after crawl)
WEB_APP_URL=http://localhost:3000

# Nominatim geocoder — must identify your app
NOMINATIM_USER_AGENT=agenda-cartes-fr/1.0 contact@yourdomain.fr

# --- Optional (Monitoring / Notifications) ---
SENTRY_DSN=
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
